---
/**
 * "What the test walks found" — the evidence that the human gate is real.
 *
 * Built entirely from data that already exists: an iteration that `corrects` an earlier
 * one was produced by walking the running application, and each of its stories that
 * `changes` an earlier story is one finding, fixed. The walk's own journal entry (the
 * corrected iteration, tagged `testing`) and the workflow step the correction introduced
 * are linked beside them. A case study without a corrective iteration renders nothing —
 * there is no "no findings" line, because an absence that is not narrated does not speak.
 */
import { getCollection } from 'astro:content';
import { useTranslations, localize, type Lang } from '../i18n/ui';
import { iterationLabel, iterationSlug, introducedIn, type Iteration } from '../lib/iterations';

interface Props {
  lang: Lang;
  caseId: string;
  iterations: Iteration[];
  /** Story id of the case study's worked example, linked when it is one of the fixes. */
  workedExample?: string;
}
const { lang, caseId, iterations, workedExample } = Astro.props;
const t = useTranslations(lang);

const stories = (await getCollection('user-stories')).filter((s) => s.data.case.id === caseId);
const storyById = new Map(stories.map((s) => [s.id, s]));
const journal = (await getCollection('journal')).filter((j) => !j.data.draft);
const workflow = await getCollection('workflow');
const byId = new Map(iterations.map((i) => [i.id, i]));

const levelHref = (it: Iteration, anchor?: string) =>
  `/${lang}/case-studies/${caseId}/${iterationSlug(it, iterations)}${anchor ? `#${anchor}` : ''}`;

const corrections = iterations
  .filter((it) => it.data.corrects.length > 0)
  .map((it) => {
    const corrected = it.data.corrects.map((r) => byId.get(r.id)).filter((x): x is Iteration => !!x);
    const correctedIds = new Set(corrected.map((c) => c.id));
    return {
      it,
      corrected,
      fixes: introducedIn(stories, it.id).filter((s) => s.data.changes.length > 0),
      walks: journal
        .filter((j) => j.data.iteration && correctedIds.has(j.data.iteration.id) && j.data.tags.includes('testing'))
        .sort((a, b) => a.data.date.getTime() - b.data.date.getTime()),
      steps: introducedIn(workflow, it.id),
    };
  })
  .filter((c) => c.fixes.length > 0);
---
{corrections.map(({ it, corrected, fixes, walks, steps }) => (
  <section class="walk" id="walk-findings">
    <h2>{t('walk.h2')}</h2>
    <p>{localize(it.data.summary, lang)}</p>
    {walks.length > 0 && (
      <p class="small">
        {t('walk.journal')}{' '}
        {walks.map((j, i) => (
          <>{i > 0 && ', '}<a href={`/${lang}/journal/${j.id}`}>{localize(j.data.title, lang)}</a> <span class="muted">({j.data.date.toISOString().slice(0, 10)})</span></>
        ))}
      </p>
    )}

    <h3>{t('walk.fixes')} <a href={levelHref(it)}>{iterationLabel(it, t('iter.level'))}</a></h3>
    <ul class="reset fixes">
      {fixes.map((s) => (
        <li>
          <a href={levelHref(it, s.id)}>{localize(s.data.title, lang)}</a>
          <span class="was small muted">
            {t('walk.changes')}{' '}
            {s.data.changes.map((r, i) => {
              const old = storyById.get(r.id);
              const oldIt = old?.data.introducedIn ? byId.get(old.data.introducedIn.id) : undefined;
              return <>{i > 0 && ', '}{oldIt ? <a href={levelHref(oldIt, r.id)}>{r.id}</a> : r.id}{oldIt && ` (${iterationLabel(oldIt, t('iter.level'))})`}</>;
            })}
          </span>
          {s.id === workedExample && <a class="chain-link small" href="#worked-example">{t('walk.followChain')}</a>}
        </li>
      ))}
    </ul>

    {steps.length > 0 && (
      <p class="changed">
        <strong>{t('walk.practice')}</strong>{' '}
        {steps.map((w, i) => <>{i > 0 && '; '}<a href={`/${lang}/how-i-work#${w.id}`}>{localize(w.data.title, lang)}</a></>)}
      </p>
    )}
    {corrected.length > 0 && <p class="small muted">{t('walk.corrects')} {corrected.map((c) => iterationLabel(c, t('iter.level'))).join(', ')}.</p>}
  </section>
))}

<style>
  .walk { margin-top: 2.2rem; }
  .fixes { display: grid; gap: .5rem; }
  .fixes li { border: 1px solid var(--border); border-radius: 6px; padding: .55rem .8rem; display: flex; flex-direction: column; }
  .was { margin-top: .15rem; }
  .chain-link { margin-top: .2rem; font-weight: 600; }
  .changed { background: var(--human-soft); border-radius: 6px; padding: .8rem 1rem; margin-top: 1rem; }
  .changed strong { color: var(--human); }
</style>
