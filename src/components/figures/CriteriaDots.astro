---
/**
 * Acceptance criteria per story, per level, as a dot plot. The total says little; the
 * density shows how much more precise the stories became as the work turned legal.
 * Counted in English — the German criteria are the same list, one per entry.
 *
 * On a level page pass `groups` (the level's topics) and each row is a topic instead,
 * measured by its total criteria — an average over one or two stories says little.
 */
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/ui';
import { iterationLabel, introducedIn, type Iteration } from '../../lib/iterations';

interface Props {
  lang: Lang;
  iterations: Iteration[];
  stories: CollectionEntry<'user-stories'>[];
  levelHref: (it: Iteration, anchor?: string) => string;
  /** One row per group (a level's topics) instead of one per level. */
  groups?: { label: string; href: string; stories: CollectionEntry<'user-stories'>[] }[];
}
const { lang, iterations, stories, levelHref, groups } = Astro.props;
const t = useTranslations(lang);
const count = (xs: typeof stories) => xs.reduce((n, s) => n + s.data.acceptanceCriteria.en.length, 0);

const row = (label: string, href: string, s: typeof stories) => {
  const total = count(s);
  return { label, href, total, avg: s.length ? total / s.length : 0 };
};
const levels = (groups
  ? groups.map((g) => row(g.label, g.href, g.stories))
  : iterations.map((it) => row(iterationLabel(it, t('iter.level')), levelHref(it, 'introduced'), introducedIn(stories, it.id))))
  .filter((l) => l.total > 0);
const measure = (l: (typeof levels)[number]) => (groups ? l.total : l.avg);
const max = Math.ceil(Math.max(1, ...levels.map(measure)));
const top = [...levels].sort((a, b) => b.avg - a.avg)[0];
const fmt = (n: number) => n.toLocaleString(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const min = Math.min(...stories.map((s) => s.data.acceptanceCriteria.en.length));
---
<div class="kpis">
  <div class="kpi"><span class="v">{fmt(count(stories) / Math.max(1, stories.length))}</span><span class="l">{t('figp.crit.avg')}</span></div>
  {top && !groups && <div class="kpi"><span class="v">{fmt(top.avg)}</span><span class="l">{t('figp.crit.top')} {top.label}</span></div>}
  <div class="kpi"><span class="v">≥ {min}</span><span class="l">{t('figp.crit.min')}</span></div>
</div>
<div class:list={['bars', { topics: groups }]}>
  {levels.map((l) => (
    <div class="bar">
      <a class="lab" href={l.href}>{l.label}</a>
      <div class="dotline"><span class="rail"></span><span class="avg" style={`left:${(measure(l) / max) * 100}%`}></span></div>
      <span class="val">{groups ? <b>{l.total}</b> : <><b>{fmt(l.avg)}</b> · {l.total}</>}</span>
    </div>
  ))}
</div>
<div class="foot">
  <span>{t(groups ? 'figp.crit.legendTopic' : 'figp.crit.legend')} 0–{max}</span>
  <span>{t('figp.crit.lang')}</span>
</div>
