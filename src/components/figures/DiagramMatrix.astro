---
/**
 * Diagrams as a kind × domain-object matrix, with the diagram names inside the cells, so
 * the count and the items share one place and 18 diagrams stay readable. The columns are
 * the project's own topics (its epic spine: customers, projects, offers, invoices …),
 * and a diagram's topic is DERIVED exactly as the level pages derive it (`groupByTopic`:
 * explicit topic list, else the story that cites it). What no topic claims — the solution
 * structure, the delivery pipeline — gets a cross-cutting column last. Each chip keeps its
 * level as a small label, since the columns no longer say when it was drawn.
 */
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localize, type Lang, type UiKey } from '../../i18n/ui';
import { iterationLabel, type Iteration } from '../../lib/iterations';
import { groupByTopic, type Topic } from '../../lib/topics';

interface Props {
  lang: Lang;
  iterations: Iteration[];
  diagrams: CollectionEntry<'diagrams'>[];
  stories: CollectionEntry<'user-stories'>[];
  topics: Topic[];
  levelHref: (it: Iteration, anchor?: string) => string;
}
const { lang, iterations, diagrams, stories, topics, levelHref } = Astro.props;
const t = useTranslations(lang);

const { groups, unassigned } = groupByTopic(topics, { diagrams, stories: [], adrs: [] }, stories);
const columns = [
  ...groups.map((g) => ({ key: g.topic!.id, label: localize(g.topic!.data.title, lang)!, diagrams: g.diagrams })),
  ...(unassigned ? [{ key: 'cross', label: t('figp.dia.cross'), diagrams: unassigned.diagrams }] : []),
];

const TYPES = ['bpmn', 'uml', 'c4', 'event-storming', 'mermaid'] as const;
const types = TYPES.filter((ty) => diagrams.some((d) => d.data.type === ty));
const byId = new Map(iterations.map((i) => [i.id, i]));
const iterOf = (d: CollectionEntry<'diagrams'>) => (d.data.introducedIn ? byId.get(d.data.introducedIn.id) : undefined);
const top = [...columns].sort((a, b) => b.diagrams.length - a.diagrams.length)[0];
---
<div class="kpis">
  <div class="kpi">
    <span class="v">{types.map((ty) => diagrams.filter((d) => d.data.type === ty).length).join(' · ')}</span>
    <span class="l">{types.map((ty) => t(`figp.dia.${ty}.short` as UiKey)).join(' · ')}</span>
  </div>
  <div class="kpi"><span class="v">{groups.length}</span><span class="l">{t('figp.dia.objects')}</span></div>
  {top && <div class="kpi"><span class="v">{top.diagrams.length}</span><span class="l">{t('figp.dia.top')} {top.label}</span></div>}
</div>
<div class="scroll">
  <table class="mx" style={`min-width:${5.2 + columns.length * 7}rem`}>
    <thead><tr><th class="row"></th>{columns.map((c) => <th>{c.label}</th>)}</tr></thead>
    <tbody>
      {types.map((ty) => (
        <tr>
          <th class="row">{t(`figp.dia.${ty}` as UiKey)}<br /><span class="muted">{t(`figp.dia.${ty}.short` as UiKey)}</span></th>
          {columns.map((c) => {
            const ds = c.diagrams.filter((d) => d.data.type === ty);
            return ds.length === 0
              ? <td class="empty"></td>
              : <td><span class="cnt">{ds.length}</span>{ds.map((d) => {
                  const it = iterOf(d);
                  return <a class="chip" href={it ? levelHref(it, d.id) : undefined}>
                    {localize(d.data.title, lang)}
                    {it && <span class="lvl">{iterationLabel(it, t('iter.level'))}</span>}
                  </a>;
                })}</td>;
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<div class="foot">
  <span>{t('figp.dia.legend')}</span>
</div>
