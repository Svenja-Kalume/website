---
/**
 * The dated log itself: entries grouped by year, newest first.
 *
 * Shared by the journal index and the per-tag pages, so a filtered view is the same
 * list with fewer entries rather than a second rendering that can drift.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localize, type Lang } from '../i18n/ui';
import { allIterations, iterationLabel } from '../lib/iterations';
import { tagsHref, toggleTag } from '../lib/journal';

type Entry = CollectionEntry<'journal'>;
interface Props { entries: Entry[]; lang: Lang; activeTags?: string[]; }
const { entries, lang, activeTags = [] } = Astro.props;
const t = useTranslations(lang);

// Group by year, then by month, so the log reads as a timeline rather than one long run
// of dates. Entries arrive newest first, so each bucket keeps that order as it is filled.
// Read in UTC throughout: the dates are date-only values parsed as UTC midnight, and a
// local-time getter would move an entry into the previous month west of Greenwich.
const byMonth = new Map<string, Entry[]>();
for (const e of entries) {
  const key = `${e.data.date.getUTCFullYear()}-${e.data.date.getUTCMonth()}`;
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key)!.push(e);
}
const months = [...byMonth.keys()]
  .map((key) => {
    const [year, month] = key.split('-').map(Number);
    return { key, year, month, entries: byMonth.get(key)! };
  })
  .sort((a, b) => b.year - a.year || b.month - a.month);

// The year heads the first month that belongs to it, so a year needs no bucket of its own.
// First in this order means the newest month of that year — the one the reader meets first.
const firstOfYear = new Set<string>();
const seenYears = new Set<number>();
for (const m of months) {
  if (seenYears.has(m.year)) continue;
  seenYears.add(m.year);
  firstOfYear.add(m.key);
}

const locale = lang === 'de' ? 'de-DE' : 'en-US';
const monthName = (year: number, month: number) =>
  new Date(Date.UTC(year, month, 1)).toLocaleDateString(locale, { month: 'long', timeZone: 'UTC' });
// The month heading carries the month, so the entry only has to carry its day.
const fmt = (d: Date) => String(d.getUTCDate()).padStart(2, '0');

// Resolve the (optional) case study each entry links back to. While there is exactly one
// case study every entry would carry the same chip, which distinguishes nothing, so the map
// stays empty and nothing renders. A second case study fills it again -- derived from the
// content, not switched by a flag.
const cases = new Map<string, string | undefined>();
if ((await getCollection('case-studies')).length > 1) {
  for (const e of entries) {
    if (e.data.case) cases.set(e.id, localize((await getEntry(e.data.case))?.data.title, lang));
  }
}

// The implementation level each entry belongs to. Loaded once for the whole list rather
// than resolved per entry, and rendered as a link into that level's page.
const iterationById = new Map((await allIterations()).map((i) => [i.id, i]));
const levelOf = (e: Entry) => {
  const it = e.data.iteration ? iterationById.get(e.data.iteration.id) : undefined;
  return it && {
    label: iterationLabel(it, t('iter.level')),
    href: `/${lang}/case-studies/${it.data.case.id}/${it.data.version}`,
    title: localize(it.data.title, lang),
  };
};
---
{months.map((m) => (
  <section class="log-month">
    {firstOfYear.has(m.key) && <h2>{m.year}</h2>}
    <h3 class="log-month-heading">{monthName(m.year, m.month)}</h3>
    <ol class="reset log">
      {m.entries.map((e) => (
        <li class="log-entry">
          <time class="log-date small muted" datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
          <div class="log-body">
            <a class="card-link" href={`/${lang}/journal/${e.id}`}><strong>{localize(e.data.title, lang)}</strong></a>
            {e.data.summary && <p class="small muted">{localize(e.data.summary, lang)}</p>}
            <p class="small log-meta">
              {e.data.case && cases.get(e.id) && <span class="tag">{cases.get(e.id)}</span>}
              {levelOf(e) && (
                <a class="tag" href={levelOf(e)!.href} title={levelOf(e)!.title}>{levelOf(e)!.label}</a>
              )}
              {/* Each tag is the filter, and it toggles: on a filtered page it narrows the
                  selection further, and a tag already selected links back out of it. */}
              {e.data.tags.map((tag) => (
                <a
                  class="tag"
                  href={tagsHref(lang, toggleTag(activeTags, tag))}
                  aria-current={activeTags.includes(tag) ? 'page' : undefined}
                >{tag}</a>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
))}
