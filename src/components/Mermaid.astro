---
// Client-side Mermaid rendering (light build, no headless browser needed).
// Can be switched to build-time SVG (rehype-mermaid + Playwright) -- see CLAUDE.md.
//
// The figure carries two different things, and only one of them is for the reader:
//   - the WRITTEN caption, if the diagram has one — that is prose about the diagram, and
//     it shows;
//   - the path derived from the diagram's own labels (src/lib/mermaid-text.ts), which
//     exists so a crawler and a screen reader get more than a script tag. Printed on the
//     page it is just the picture read out as a chain of arrows, standing next to the
//     picture — so it is always rendered, always for assistive technology, never in sight.
//     A caption is no substitute for it: prose about a diagram is not the diagram.
import { describeMermaid } from '../lib/mermaid-text';

interface Props { code: string; caption?: string; }
const { code, caption } = Astro.props;
const described = describeMermaid(code);
---
<figure class="mermaid-figure">
  {/* Hidden from assistive technology on purpose, in both of its states: before the script
      runs it holds Mermaid source, which read aloud is noise, and afterwards the generated
      SVG, which carries no accessible name of its own. The figcaptions below are what the
      figure says. */}
  <div class="mermaid-wrap" aria-hidden="true">
    <pre class="mermaid">{code}</pre>
  </div>
  {caption && <figcaption class="muted small">{caption}</figcaption>}
  {described && <figcaption class="visually-hidden">{described}</figcaption>}
</figure>

<style>
  .mermaid-figure { margin: 0 0 1.4rem; }
  .mermaid-figure figcaption { margin-top: .5rem; }

  /* Mermaid scales an SVG down to fit its container, and the page measure is narrow
     (--max: 46rem). A wide graph with prose labels therefore shrank until the text was
     unreadable. Scrolling a wide diagram is better than shrinking every diagram: the
     labels keep their size, and only the graphs that genuinely do not fit ask the reader
     to scroll. `useMaxWidth: false` below is the other half of this. */
  .mermaid-wrap { overflow-x: auto; }
  .mermaid-wrap :global(svg) { max-width: none; height: auto; }
</style>

<script>
  import mermaid from 'mermaid';
  mermaid.initialize({
    startOnLoad: false,
    theme: 'neutral',
    // Node labels are read, not glanced at, and a note is a remark rather than a warning:
    // the neutral theme paints notes dark, which made them the loudest thing on the page.
    themeVariables: {
      fontSize: '16px',
      noteBkgColor: '#f3f3f1',
      noteTextColor: '#222',
      noteBorderColor: '#bbb',
    },
    // Render at natural size; .mermaid-wrap scrolls when that is wider than the measure.
    // The spacing is tighter than the default because these graphs are small and were
    // reading as a scatter of boxes with a lot of air between them.
    flowchart: {
      useMaxWidth: false,
      nodeSpacing: 34,
      rankSpacing: 44,
      padding: 8,
      subGraphTitleMargin: { top: 4, bottom: 10 },
    },
    // mirrorActors repeats the whole actor row under the diagram, which doubles its height
    // and says nothing the row at the top has not already said.
    sequence: { useMaxWidth: false, mirrorActors: false, actorMargin: 28, width: 120, boxMargin: 8 },
    state: { useMaxWidth: false },
    // A class with no attributes still got two empty compartments drawn under its name.
    class: { useMaxWidth: false, hideEmptyMembersBox: true },
  });
  const run = () => mermaid.run({ querySelector: '.mermaid' });
  run();
  document.addEventListener('astro:page-load', run);
</script>
