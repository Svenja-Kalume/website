---
// Client-side Mermaid rendering (light build, no headless browser needed).
// Can be switched to build-time SVG (rehype-mermaid + Playwright) -- see CLAUDE.md.
//
// The figure carries two different things, and only one of them is for the reader:
//   - the WRITTEN caption, if the diagram has one — that is prose about the diagram, and
//     it shows;
//   - the path derived from the diagram's own labels (src/lib/mermaid-text.ts), which
//     exists so a crawler and a screen reader get more than a script tag. Printed on the
//     page it is just the picture read out as a chain of arrows, standing next to the
//     picture — so it is always rendered, always for assistive technology, never in sight.
//     A caption is no substitute for it: prose about a diagram is not the diagram.
import { describeMermaid } from '../lib/mermaid-text';

interface Props { code: string; caption?: string; }
const { code, caption } = Astro.props;
const described = describeMermaid(code);
---
<figure class="mermaid-figure">
  {/* Hidden from assistive technology on purpose, in both of its states: before the script
      runs it holds Mermaid source, which read aloud is noise, and afterwards the generated
      SVG, which carries no accessible name of its own. The figcaptions below are what the
      figure says. */}
  <div class="mermaid-wrap" aria-hidden="true">
    <pre class="mermaid">{code}</pre>
  </div>
  {caption && <figcaption class="muted small">{caption}</figcaption>}
  {described && <figcaption class="visually-hidden">{described}</figcaption>}
</figure>

<style>
  .mermaid-figure { margin: 0 0 1.4rem; }
  .mermaid-figure figcaption { margin-top: .5rem; }
</style>

<script>
  import mermaid from 'mermaid';
  mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
  const run = () => mermaid.run({ querySelector: '.mermaid' });
  run();
  document.addEventListener('astro:page-load', run);
</script>
