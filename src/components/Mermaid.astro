---
// Client-side Mermaid rendering (light build, no headless browser needed).
// Can be switched to build-time SVG (rehype-mermaid + Playwright) -- see CLAUDE.md.
//
// The figure carries a caption: the written one where a diagram has it, otherwise the
// path derived from the diagram's own labels (src/lib/mermaid-text.ts). Without it the
// diagram is a script tag to a crawler and silence to a screen reader.
import { describeMermaid } from '../lib/mermaid-text';

interface Props { code: string; caption?: string; }
const { code, caption } = Astro.props;
const text = caption ?? describeMermaid(code);
---
<figure class="mermaid-figure">
  <div class="mermaid-wrap">
    <pre class="mermaid">{code}</pre>
  </div>
  {text && <figcaption class="muted small">{text}</figcaption>}
</figure>

<style>
  .mermaid-figure { margin: 0 0 1.4rem; }
  .mermaid-figure figcaption { margin-top: .5rem; }
</style>

<script>
  import mermaid from 'mermaid';
  mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
  const run = () => mermaid.run({ querySelector: '.mermaid' });
  run();
  document.addEventListener('astro:page-load', run);
</script>
