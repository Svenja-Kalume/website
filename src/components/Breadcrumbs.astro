---
/**
 * Breadcrumbs. Needed once the case study gained a third level (iteration) — three
 * levels without them is where a docs-like site starts feeling lost.
 *
 * Deliberately NOT a nav item: the top-level nav stays six entries of chrome. The
 * iteration hierarchy lives inside the case study, where it belongs.
 */
import { absoluteUrl, breadcrumbSchema } from '../lib/schema';

interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;

const jsonLd = breadcrumbSchema(
  items.map((c) => ({ label: c.label, url: c.href ? absoluteUrl(c.href, Astro.site) : undefined }))
);
---
<nav class="crumbs small muted" aria-label="Breadcrumb">
  {items.map((c, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> › </span>}
      {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .crumbs { margin: 0 0 1rem; }
  .crumbs a { color: inherit; }
</style>
