---
/**
 * One user story with its traceability chain (requirement → process → decisions →
 * working doc). References are resolved here, so every page that shows a story shows
 * the same chain rather than re-deriving it.
 *
 * Compact by default: a level page holds 15–25 of these, and fully expanded they made it
 * the longest page on the site. The closed card keeps what a skimming reader needs — the
 * title, the requirement it serves and the first sentence of the AI contribution, since
 * that contribution is what the site exists to show — and opens to the full story. A link
 * to the story's #id opens it (see the script at the foot).
 *
 * No status tag: only `done` stories are published, so it said the same thing on every
 * card.
 *
 * `codeUrl` is deliberately not rendered. The repos are never linked, so the path could
 * only ever appear as inert text — a file name in a chain of titles, read as noise. It
 * stays on the artifact as the exact citation it is, for the day a repo does open.
 *
 * `tag` is the release tag of the story's own iteration: repo-relative paths resolve
 * against it, so a published story keeps citing its working doc as it stood at its level.
 */
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localize, type Lang } from '../i18n/ui';
import { resolveRepoPath, iterationSlug } from '../lib/iterations';

interface Props {
  story: CollectionEntry<'user-stories'>;
  lang: Lang;
  repoUrl?: string;
  tag?: string;
}
const { story, lang, repoUrl, tag } = Astro.props;
const t = useTranslations(lang);

const requirement = await getEntry(story.data.requirement);
const adrs = await Promise.all(story.data.adr.map((r) => getEntry(r)));
const bpmn = story.data.bpmn ? await getEntry(story.data.bpmn) : undefined;
const sourceHref = resolveRepoPath(story.data.source, repoUrl, tag);
// A decision lives on the level that introduced it, which need not be this story's level.
const allIterations = await getCollection('iterations');
const adrHref = (a: CollectionEntry<'adr'>) => {
  const it = allIterations.find((i) => i.id === a.data.introducedIn?.id);
  return it ? `/${lang}/case-studies/${it.data.case.id}/${iterationSlug(it, allIterations)}#${a.id}` : `#${a.id}`;
};
const ai = localize(story.data.aiContribution, lang) ?? '';
const aiFirst = ai.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? ai;
const criteria = localize<string[]>(story.data.acceptanceCriteria, lang)!;
---
<details class="card story" id={story.id}>
  <summary>
    <span class="card-title">{story.id}: {localize(story.data.title, lang)}</span>
    {story.data.jiraKey && <span class="tag" style="margin-left:.3rem">Jira {story.data.jiraKey}</span>}
    <span class="meta small muted">
      {requirement ? `${requirement.id} — ${localize(requirement.data.title, lang)}` : story.data.requirement.id}
      {' · '}{criteria.length} {t('case.acceptance')}
    </span>
    <span class="teaser small"><b>{t('case.aiContribution')}</b> {aiFirst}</span>
  </summary>
  <p class="small" style="margin:.6rem 0 .5rem">
    {t('case.asA')} <em>{localize(story.data.asA, lang)}</em> {t('case.iWant')} <em>{localize(story.data.iWant, lang)}</em>, {t('case.soThat')} <em>{localize(story.data.soThat, lang)}</em>.
  </p>
  <p class="small flow">
    <span class="step">{t('case.requirement')} {requirement ? <a href={`/${lang}/traceability#${requirement.id}`}>{requirement.id} — {localize(requirement.data.title, lang)}</a> : story.data.requirement.id}</span>
    {bpmn && <span class="step">{t('case.process')} {localize(bpmn.data.title, lang)}</span>}
    {adrs.length > 0 && <span class="step">{t('case.decisions')} {adrs.filter(Boolean).map((a, i) => <>{i > 0 && '; '}<a href={adrHref(a!)}>{localize(a!.data.title, lang)}</a></>)}</span>}
    {sourceHref && <span class="step"><a href={sourceHref}>{t('case.source')}</a></span>}
  </p>
  <h4 class="crit">{t('case.acceptance')} ({criteria.length})</h4>
  <ul>{criteria.map((c) => <li class="small">{c}</li>)}</ul>
  <p class="ai-note"><b>{t('case.aiContribution')}</b> {ai}</p>
</details>

<script>
  // A link to a story or decision (#WZ-US-39) opens its card before the browser scrolls
  // to it — a closed card would hide what the link points at.
  const openTarget = () => {
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const card = el?.closest('details');
    if (card && !card.open) { card.open = true; el!.scrollIntoView(); }
  };
  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>

<style>
  .story summary { cursor: pointer; list-style: none; display: flex; flex-direction: column; gap: .2rem; }
  .story summary::-webkit-details-marker { display: none; }
  .story summary .card-title::after { content: " ▸"; color: var(--muted); font-size: .8em; }
  .story[open] summary .card-title::after { content: " ▾"; }
  .story .teaser { color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .story .teaser b { color: var(--fg); font-weight: 600; }
  .story[open] .teaser { display: none; }
  .story .crit { font-size: .9rem; margin: .8rem 0 .2rem; }
  .story ul { margin: 0; }
</style>
