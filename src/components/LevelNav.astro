---
/**
 * Submenu across a case study's published iterations.
 *
 * The site's claim is development over time — Level 1 still standing when Level 2 is
 * published. That only reads as a claim if you can step between the levels; going back
 * to the case study every time makes them feel like a list rather than a sequence.
 *
 * Ordered OLDEST FIRST, left to right, because the sequence is the argument: it is how
 * the way of working grew. (The overview page lists them newest first — there you are
 * looking for the current state, here you are walking the path.)
 *
 * Labels are the level word alone ("Overview · Level 1 · Level 2"): the release version is
 * on the page it leads to, and repeating it here only adds noise to a menu whose job is
 * to say where in the sequence you are. Labels degrade with the schema: `level` is
 * wurzel's scheduling vocabulary and stays optional, so a project without it falls back
 * to its version. Nothing here requires an iteration to be anything but published.
 */
import { useTranslations, localize, type Lang } from '../i18n/ui';
import { iterationLabel, iterationSlug, releaseBadge, type Iteration } from '../lib/iterations';

interface Props {
  lang: Lang;
  caseId: string;
  /** Ascending by `order` — pass `iterationsOf(...)` straight in. */
  iterations: Iteration[];
  /**
   * The id of the iteration being shown, or undefined on the case study's own page.
   * Deliberately the id and not the version: one release tag can ship two iterations
   * (wurzel 0.3.0 = Levels 3 and 4), and comparing versions would mark both as current.
   */
  currentId?: string;
}
const { lang, caseId, iterations, currentId } = Astro.props;
const t = useTranslations(lang);

// A single iteration is not a sequence; the breadcrumbs already say where you are.
const show = iterations.length > 1;

const label = (it: Iteration) => iterationLabel(it, t('iter.level'));
---
{show && (
  <nav class="levels small" aria-label={t('iter.nav')}>
    <a
      href={`/${lang}/case-studies/${caseId}`}
      aria-current={currentId === undefined ? 'page' : undefined}
    >{t('iter.overview')}</a>
    {iterations.map((it) => (
      <a
        href={`/${lang}/case-studies/${caseId}/${iterationSlug(it, iterations)}`}
        aria-current={it.id === currentId ? 'page' : undefined}
        title={localize(it.data.title, lang)}
      >{label(it)}{releaseBadge(it, iterations) && (
          <span class="ver">v{releaseBadge(it, iterations)}</span>
        )}</a>
    ))}
  </nav>
)}

<style>
  /* Docs-like, no animation: a row of quiet links, the current one filled in. */
  .levels {
    display: flex;
    flex-wrap: wrap;
    /* The badge overhangs the chip, so the row needs headroom of its own and a wider
       column gap than a plain row of links would want. */
    gap: 0.9rem 0.7rem;
    margin: 0.55rem 0 1.5rem;
  }
  .levels a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .levels a:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  /* The release tag as a badge on the chip's top-right corner, not part of the label:
     it says which release this level shipped in, and the level word stays the name. A
     level sharing its tag with a later one shows no badge at all. */
  .levels .ver {
    position: absolute;
    top: -0.55rem;
    right: -0.35rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.7rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }
  .levels a:hover .ver {
    color: var(--accent-strong);
    border-color: var(--accent);
  }
  .levels a[aria-current='page'] .ver {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }
  .levels a[aria-current='page'] {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }
</style>
