---
/**
 * The tag filter: every tag the log uses, with the number of entries left if you pick it.
 *
 * A row of links to static per-combination pages rather than a scripted filter — the
 * filtered view then has its own URL you can cite, and the page needs no JavaScript.
 *
 * Selection is additive and every chip is a toggle: picking a second tag narrows to the
 * entries carrying both, picking a selected one again drops it. The count on an unselected
 * chip is the result of that click, not the tag's total, so it never promises entries the
 * combination does not have — and a tag that would empty the list is shown inert rather
 * than as a link into nothing. A selected chip carries no count: the number that matters
 * there is what the page is showing, and the heading above already states it.
 *
 * Chips are laid out in one labelled row per tag group (domain, code, AI), so the row reads
 * as "what about" rather than one flat list. Grouping is layout only — selection still
 * combines freely across groups. An empty group is not rendered.
 */
import { useTranslations, type Lang } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import { tagCounts, filterByTags, tagsHref, toggleTag, tagGroup, tagGroups } from '../lib/journal';

interface Props { entries: CollectionEntry<'journal'>[]; lang: Lang; activeTags?: string[]; }
const { entries, lang, activeTags = [] } = Astro.props;
const t = useTranslations(lang);

// Ordered by overall use, so the row keeps the same order whatever is selected.
const chips = tagCounts(entries).map(({ tag }) => {
  const next = toggleTag(activeTags, tag);
  return {
    tag,
    active: activeTags.includes(tag),
    href: tagsHref(lang, next),
    count: filterByTags(entries, next).length,
  };
});
const groups = tagGroups
  .map((group) => ({ group, chips: chips.filter(({ tag }) => tagGroup(tag) === group) }))
  .filter(({ chips }) => chips.length > 0);
---
{chips.length > 0 && (
  <nav class="tag-filter small" aria-label={t('journal.filter')}>
    <span class="label" aria-hidden="true"></span>
    <div class="chips">
      <a href={`/${lang}/journal`} aria-current={activeTags.length === 0 ? 'page' : undefined}>
        {t('journal.allTags')}
      </a>
    </div>
    {groups.map(({ group, chips }) => (
      <>
        <span class="label muted" id={`tag-group-${group}`}>{t(`journal.group.${group}`)}</span>
        <div class="chips" role="group" aria-labelledby={`tag-group-${group}`}>
          {chips.map(({ tag, active, href, count }) => (
            count === 0 && !active
              ? <span class="inert" aria-disabled="true">{tag} <span class="count">(0)</span></span>
              : <a href={href} aria-current={active ? 'page' : undefined}>
                  {tag}{!active && <span class="count muted"> ({count})</span>}
                </a>
          ))}
        </div>
      </>
    ))}
  </nav>
)}

<style>
  /* Two columns — group label, then its chips — so every group starts at the same x and a
     wrapped line of chips stays under its own group rather than under the label. */
  .tag-filter {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1rem;
    row-gap: 0.5rem;
    align-items: baseline;
    margin: 0 0 1.6rem;
  }
  .tag-filter .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .tag-filter .label {
    font-size: 0.85em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  @media (max-width: 40rem) {
    .tag-filter { grid-template-columns: 1fr; row-gap: 0.3rem; }
    .tag-filter .label:empty { display: none; }
    .tag-filter .label { margin-top: 0.4rem; }
  }
  .tag-filter a,
  .tag-filter .inert {
    color: var(--muted);
    text-decoration: none;
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    /* A tag and its count are one chip: wrap between chips, never inside one. */
    white-space: nowrap;
  }
  .tag-filter a:hover { color: var(--accent-strong); border-color: var(--accent); }
  .tag-filter a[aria-current='page'] {
    color: var(--accent-strong);
    background: var(--accent-soft);
    border-color: var(--accent);
    font-weight: 600;
  }
  .tag-filter a[aria-current='page'] .count { color: inherit; }
  /* Not reachable, so not a link — dimmed rather than hidden, so the row does not
     reshuffle as you narrow and you can see what the selection ruled out. */
  .tag-filter .inert { opacity: 0.45; }
  .tag-filter .count { font-variant-numeric: tabular-nums; }
</style>
