---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, toLang } from '../../i18n/ui';
import { absoluteUrl, personSchema } from '../../lib/schema';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  title={t('about.title')}
  description={t('about.desc')}
  jsonLd={personSchema(lang, absoluteUrl(`/${lang}/about/`, Astro.site))}
>
  <h1>{t('about.h1')}</h1>
  <p>{t('about.p1')}</p>
  <p>{t('about.p2')}</p>
  <p>{t('about.p3')}</p>
  <p>{t('about.p4')}</p>
  <h2>{t('about.contact')}</h2>
  <p class="muted">
    <a href="mailto:svenja.kalume@hotmail.com">svenja.kalume@hotmail.com</a>
    · <a href="https://www.linkedin.com/in/svenja-kalume/">LinkedIn</a>
  </p>
</BaseLayout>
