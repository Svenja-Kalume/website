---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import LevelNav from '../../../../components/LevelNav.astro';
import { absoluteUrl, techArticleSchema } from '../../../../lib/schema';
import DiagramFigure from '../../../../components/DiagramFigure.astro';
import StoryCard from '../../../../components/StoryCard.astro';
import AdrCard from '../../../../components/AdrCard.astro';
import GlossaryTerms from '../../../../components/GlossaryTerms.astro';
import { languages, useTranslations, localize, toLang } from '../../../../i18n/ui';
import { iterationsOf, currentOf, introducedIn } from '../../../../lib/iterations';
import { topicsOf, groupByTopic } from '../../../../lib/topics';

/**
 * One published iteration, at a stable citable URL: /en/case-studies/wurzel/0.1.0
 *
 * That URL is the point. "0.1.0 stays available when 0.2.0 is described" means exactly
 * this page keeps existing, unchanged, forever — it is the link you can put in an
 * application. Chosen over anchors on one long page for that reason.
 *
 * The route loops over every case study's iterations; it never mentions a project.
 */
export async function getStaticPaths() {
  const cases = await getCollection('case-studies');
  const all = await getCollection('iterations');
  return Object.keys(languages).flatMap((lang) =>
    cases.flatMap((caseEntry) =>
      iterationsOf(all, caseEntry.id).map((iteration) => ({
        params: { lang, slug: caseEntry.id, version: iteration.data.version },
        props: { caseEntry, iteration },
      }))
    )
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { caseEntry, iteration } = Astro.props;
const { Content } = await render(iteration);

const all = await getCollection('iterations');
const isCurrent = currentOf(all, caseEntry.id)?.id === iteration.id;
// Siblings, oldest first — the submenu that lets you walk the levels in order.
const caseIterations = iterationsOf(all, caseEntry.id);

// Diagrams, stories and ADRs belong to the level that introduced them, and are rendered
// here in full — the case study page is the overview. The rest stays a listing.
const allStories = await getCollection('user-stories');
const diagrams = introducedIn(await getCollection('diagrams'), iteration.id);
const stories = introducedIn(allStories, iteration.id);
const adrs = introducedIn(await getCollection('adr'), iteration.id);

// Sub-chapters by domain topic: each group carries its own diagrams, stories with their
// traceability chain, and decisions — so a level reads as "what happened to the customer,
// then to the project", not as three long lists you have to cross-reference yourself.
const topics = topicsOf(await getCollection('topics'), caseEntry.id);
const { groups: topicGroups, unassigned } = groupByTopic(
  topics,
  { diagrams, stories, adrs },
  allStories.filter((s) => s.data.case.id === caseEntry.id),
);
const sections = [...topicGroups, ...(unassigned ? [unassigned] : [])];

// What this iteration introduced. Every versioned collection, so nothing is silently
// left out of the record of what a level actually published.
const groups = [
  { key: 'requirements', label: t('iter.requirements'), items: introducedIn(await getCollection('requirements'), iteration.id) },
  { key: 'workflow', label: t('iter.workflow'), items: introducedIn(await getCollection('workflow'), iteration.id) },
].filter((g) => g.items.length > 0);

// The repo is not linked (see `repoAccess`): say why once, above the paths, so an
// unresolved `codeUrl` reads as a client's decision rather than a missing link.
const repoNote = !caseEntry.data.repoUrl && stories.some((s) => s.data.codeUrl)
  ? (caseEntry.data.repoNote ? localize(caseEntry.data.repoNote, lang) : t('case.repoPrivate'))
  : undefined;

const corrects = await Promise.all((iteration.data.corrects ?? []).map((r) => getEntry(r)));
const sameProcess = iteration.data.sameProcessAs ? await getEntry(iteration.data.sameProcessAs) : undefined;
const caseTitle = localize(caseEntry.data.title, lang) ?? caseEntry.id;
const title = localize(iteration.data.title, lang) ?? iteration.id;
const dateStr = iteration.data.date.toISOString().slice(0, 10);
---
<BaseLayout
  lang={lang}
  title={`${caseTitle} ${iteration.data.version}`}
  description={localize(iteration.data.summary, lang)}
  jsonLd={techArticleSchema({
    headline: `${caseTitle} — ${title}`,
    description: localize(iteration.data.summary, lang),
    url: absoluteUrl(`/${lang}/case-studies/${caseEntry.id}/${iteration.data.version}/`, Astro.site),
    lang,
    datePublished: iteration.data.date,
    version: iteration.data.version,
  })}
>
  <Breadcrumbs items={[
    { label: t('nav.cases'), href: `/${lang}/case-studies` },
    { label: caseTitle, href: `/${lang}/case-studies/${caseEntry.id}` },
    { label: iteration.data.version },
  ]} />
  <LevelNav lang={lang} caseId={caseEntry.id} iterations={caseIterations} currentVersion={iteration.data.version} />

  <h1>{title}</h1>
  <p class="small">
    <span class="tag">v{iteration.data.version}</span>
    {iteration.data.level !== undefined && <span class="tag" style="margin-left:.3rem">{t('iter.level')} {iteration.data.level}</span>}
    {isCurrent && <span class="tag" style="margin-left:.3rem">{t('iter.current')}</span>}
    <time class="muted" datetime={dateStr} style="margin-left:.5rem">{dateStr}</time>
  </p>

  <p>{localize(iteration.data.summary, lang)}</p>
  {(localize(iteration.data.intro, lang) ?? []).map((p: string) => <p>{p}</p>)}

  {iteration.data.blocks.length > 0 && (
    <p class="small muted">{t('iter.blocks')} {iteration.data.blocks.join(' · ')}</p>
  )}

  {/* The headline of the whole concept: not what shipped, but what changed in how you work. */}
  {(localize(iteration.data.processChanges, lang) ?? []).length > 0 && (
    <>
      <h2>{t('iter.processChanges')}</h2>
      <ul>{(localize(iteration.data.processChanges, lang) ?? []).map((c: string) => <li>{c}</li>)}</ul>
    </>
  )}

  {/* Continuity is a finding too: features shipped, the way of working did not move. */}
  {sameProcess && (
    <>
      <h2>{t('iter.processChanges')}</h2>
      <p class="muted">
        {t('iter.sameProcessAs')}{' '}
        <a href={`/${lang}/case-studies/${caseEntry.id}/${sameProcess.data.version}`}>v{sameProcess.data.version}</a>.
      </p>
    </>
  )}

  {corrects.filter(Boolean).length > 0 && (
    <>
      <h2>{t('iter.corrects')}</h2>
      <ul>
        {corrects.filter(Boolean).map((c: any) => (
          <li><a href={`/${lang}/case-studies/${caseEntry.id}/${c.data.version}`}>{c.data.version}</a> — {localize(c.data.summary, lang)}</li>
        ))}
      </ul>
    </>
  )}

  {(localize(iteration.data.lessons, lang) ?? []).length > 0 && (
    <>
      <h2>{t('iter.lessons')}</h2>
      <ul>{(localize(iteration.data.lessons, lang) ?? []).map((l: string) => <li>{l}</li>)}</ul>
    </>
  )}

  {iteration.data.aiContribution && (
    <p class="ai-note"><strong>{t('case.aiContribution')}</strong> {localize(iteration.data.aiContribution, lang)}</p>
  )}

  <h2>{t('iter.introduced')}</h2>
  {groups.length === 0 && diagrams.length === 0 && stories.length === 0 && adrs.length === 0 && (
    <p class="muted">{t('iter.introducedEmpty')}</p>
  )}
  {groups.map((g) => (
    <div class="card">
      <strong>{g.label}</strong> <span class="muted small">({g.items.length})</span>
      <ul class="small" style="margin:.4rem 0 0">
        {g.items.map((e: any) => <li>{e.id} — {localize(e.data.title, lang)}</li>)}
      </ul>
    </div>
  ))}

  {/* Said once for the whole level, not per topic: it is one decision about the repo. */}
  {repoNote && <p class="small">{repoNote}</p>}

  {sections.map((g) => (
    <section class="topic">
      <h2>
        {g.topic ? localize(g.topic.data.title, lang) : t('topic.unassigned')}
        {/* Derived, not declared: a topic the glossary has no term for is a technical
            concern (navigation, autosave, a test harness), and says so. */}
        {g.topic && g.topic.data.glossary.length === 0 && (
          <span class="tag" style="margin-left:.5rem">{t('topic.technical')}</span>
        )}
      </h2>
      {g.topic?.data.summary && <p class="muted">{localize(g.topic.data.summary, lang)}</p>}
      {/* The topics are the project's own epic spine, not a lens invented for the site. */}
      {g.topic?.data.source && <p class="small muted"><code>{g.topic.data.source}</code></p>}
      {g.topic && <GlossaryTerms refs={g.topic.data.glossary} lang={lang} />}
      {g.topic && g.topic.data.requirements.length > 0 && (
        <p class="small muted">
          {t('topic.requirements')} {g.topic.data.requirements.map((r) => r.id).join(', ')}
        </p>
      )}

      {g.diagrams.length > 0 && (
        <>
          <h3>{t('iter.diagrams')}</h3>
          {g.diagrams.map((d) => <DiagramFigure diagram={d} lang={lang} titleTag="h4" />)}
        </>
      )}

      {g.stories.length > 0 && (
        <>
          <h3>{t('case.storiesTrace')}</h3>
          {g.stories.map((story) => (
            <StoryCard story={story} lang={lang} repoUrl={caseEntry.data.repoUrl} tag={iteration.data.version} />
          ))}
        </>
      )}

      {g.adrs.length > 0 && (
        <>
          <h3>{t('case.adr')}</h3>
          {g.adrs.map((a) => <AdrCard adr={a} lang={lang} />)}
        </>
      )}
    </section>
  ))}

  <Content />

  {iteration.data.sourceUrl && (
    <p class="small"><a href={iteration.data.sourceUrl}>{t('iter.source')}</a></p>
  )}
</BaseLayout>
