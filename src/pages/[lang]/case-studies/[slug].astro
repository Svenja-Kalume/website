---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, useTranslations, localize, toLang } from '../../../i18n/ui';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LevelNav from '../../../components/LevelNav.astro';
import DiagramFigure from '../../../components/DiagramFigure.astro';
import StoryCard from '../../../components/StoryCard.astro';
import AdrCard from '../../../components/AdrCard.astro';
import { allIterations, iterationsOf, currentOf, introducedIn, displayVersion } from '../../../lib/iterations';
import { absoluteUrl, techArticleSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const cases = await getCollection('case-studies');
  // One page per (locale × case study). References stay language-neutral.
  return Object.keys(languages).flatMap((lang) =>
    cases.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { entry } = Astro.props;
const caseId = entry.id;
const { Content } = await render(entry);

const inCase = (e: { data: { case?: { id: string } } }) => e.data.case?.id === caseId;

const stakeholders = (await getCollection('stakeholders'))
  .filter(inCase)
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const stories = (await getCollection('user-stories')).filter(inCase);
const adrs = (await getCollection('adr')).filter(inCase);
const diagrams = (await getCollection('diagrams')).filter(inCase);

const iterations = await allIterations();
const caseIterations = iterationsOf(iterations, caseId);
const current = currentOf(iterations, caseId);

// Diagrams, stories and ADRs are shown on the level that introduced them, not here: this
// page is the overview, and a flat dump of every artifact hides which increment produced
// what. Each iteration card carries the counts and links to the level that renders them.
const perIteration = new Map(
  caseIterations.map((it) => [
    it.id,
    {
      stories: introducedIn(stories, it.id).length,
      diagrams: introducedIn(diagrams, it.id).length,
      adrs: introducedIn(adrs, it.id).length,
    },
  ])
);

// Fallback, not a second home: an artifact with no `introducedIn` has no level to move to,
// so it stays visible here rather than disappearing from the site.
const looseDiagrams = diagrams.filter((d) => !d.data.introducedIn);
const looseStories = stories.filter((s) => !s.data.introducedIn);
const looseAdrs = adrs.filter((a) => !a.data.introducedIn);
---
<BaseLayout
  lang={lang}
  title={localize(entry.data.title, lang) ?? entry.id}
  description={localize(entry.data.summary, lang)}
  jsonLd={techArticleSchema({
    headline: localize(entry.data.title, lang) ?? entry.id,
    description: localize(entry.data.summary, lang),
    url: absoluteUrl(`/${lang}/case-studies/${entry.id}/`, Astro.site),
    lang,
    datePublished: current?.data.date,
    version: displayVersion(iterations, entry),
  })}
>
  <Breadcrumbs items={[
    { label: t('nav.cases'), href: `/${lang}/case-studies` },
    { label: localize(entry.data.title, lang) ?? entry.id },
  ]} />
  <LevelNav lang={lang} caseId={caseId} iterations={caseIterations} />
  <h1>{localize(entry.data.title, lang)}</h1>
  <p>
    <span class="tag">v{displayVersion(iterations, entry)}</span>
    <span class="tag">{entry.data.status}</span>
    {entry.data.demoUrl && <a class="button" style="margin-left:.6rem" href={entry.data.demoUrl}>{t('cases.openDemo')}</a>}
  </p>

  <div>
    {entry.data.intro
      ? localize<string[]>(entry.data.intro, lang)!.map((p) => <p>{p}</p>)
      : <Content />}
  </div>

  {/* The development-over-time view: every published iteration stays listed and reachable,
      newest first. Each has its own stable URL — earlier ones never disappear. */}
  {caseIterations.length > 0 && (
    <>
      <h2>{t('iter.h2')}</h2>
      <ul class="reset">
        {[...caseIterations].reverse().map((it) => (
          <li class="card">
            <a class="card-link" href={`/${lang}/case-studies/${caseId}/${it.data.version}`}>
              <strong>{localize(it.data.title, lang)}</strong>
            </a>
            <span class="tag" style="margin-left:.5rem">v{it.data.version}</span>
            {it.id === current?.id && <span class="tag" style="margin-left:.3rem">{t('iter.current')}</span>}
            <span class="muted small" style="margin-left:.5rem">{it.data.date.toISOString().slice(0, 10)}</span>
            <p class="muted small" style="margin:.4rem 0 0">{localize(it.data.summary, lang)}</p>
            <p class="muted small" style="margin:.3rem 0 0">
              {perIteration.get(it.id)!.stories} {t('iter.stories')} · {perIteration.get(it.id)!.diagrams} {t('iter.diagrams')} · {perIteration.get(it.id)!.adrs} {t('iter.adr')}
            </p>
          </li>
        ))}
      </ul>
    </>
  )}

  {stakeholders.length > 0 && (
    <>
      <h2>{t('case.stakeholders')}</h2>
      <ul class="reset">
        {stakeholders.map((s) => (
          <li class="card">
            <strong>{s.data.name}</strong> — {localize(s.data.role, lang)}
            <span class="tag" style="margin-left:.5rem">{t('case.influence')} {s.data.influence}</span>
            {localize<string[]>(s.data.interests, lang)!.length > 0 && (
              <p class="muted small" style="margin:.3rem 0 0">{t('case.interests')} {localize<string[]>(s.data.interests, lang)!.join(', ')}</p>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  {looseDiagrams.length > 0 && (
    <>
      <h2>{t('iter.diagrams')}</h2>
      {looseDiagrams.map((d) => <DiagramFigure diagram={d} lang={lang} />)}
    </>
  )}

  {looseStories.length > 0 && (
    <>
      <h2>{t('case.storiesTrace')}</h2>
      {looseStories.map((story) => (
        <StoryCard story={story} lang={lang} repoUrl={entry.data.repoUrl} />
      ))}
    </>
  )}

  {looseAdrs.length > 0 && (
    <>
      <h2>{t('case.adr')}</h2>
      {looseAdrs.map((a) => <AdrCard adr={a} lang={lang} />)}
    </>
  )}
</BaseLayout>
