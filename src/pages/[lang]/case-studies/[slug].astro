---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Mermaid from '../../../components/Mermaid.astro';
import { languages, useTranslations, localize, toLang } from '../../../i18n/ui';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LevelNav from '../../../components/LevelNav.astro';
import { allIterations, resolveRepoPath, iterationsOf, currentOf, displayVersion } from '../../../lib/iterations';

export async function getStaticPaths() {
  const cases = await getCollection('case-studies');
  // One page per (locale × case study). References stay language-neutral.
  return Object.keys(languages).flatMap((lang) =>
    cases.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { entry } = Astro.props;
const caseId = entry.id;
const { Content } = await render(entry);

const inCase = (e: { data: { case?: { id: string } } }) => e.data.case?.id === caseId;

const stakeholders = (await getCollection('stakeholders')).filter(inCase);
const stories = (await getCollection('user-stories')).filter(inCase);
const adrs = (await getCollection('adr')).filter(inCase);
const diagrams = (await getCollection('diagrams')).filter(inCase);

// A repo-relative codeUrl resolves against the case study's repoUrl, pinned to the tag of
// the iteration that published the story. Unresolvable (no repoUrl yet) → show the path.
const iterations = await allIterations();
const tagOf = new Map(iterations.map((i) => [i.id, i.data.version]));
const caseIterations = iterationsOf(iterations, caseId);
const current = currentOf(iterations, caseId);

// Resolve references so titles are shown instead of raw IDs.
const storyRows = await Promise.all(
  stories.map(async (s) => ({
    story: s,
    requirement: await getEntry(s.data.requirement),
    adrs: await Promise.all(s.data.adr.map((r) => getEntry(r))),
    bpmn: s.data.bpmn ? await getEntry(s.data.bpmn) : undefined,
    codeHref: resolveRepoPath(s.data.codeUrl, entry.data.repoUrl, tagOf.get(s.data.introducedIn?.id ?? '')),
    // The vault doc this story was written from, pinned to its own iteration's tag — so
    // reorganising the docs later cannot rot an older iteration's citation.
    sourceHref: resolveRepoPath(s.data.source, entry.data.repoUrl, tagOf.get(s.data.introducedIn?.id ?? '')),
  }))
);

// The repo is not linked (see `repoAccess`): say why once, above the paths, so an
// unresolved `codeUrl` reads as a client's decision rather than a missing link.
const repoNote = !entry.data.repoUrl && storyRows.some((r) => r.story.data.codeUrl)
  ? (entry.data.repoNote ? localize(entry.data.repoNote, lang) : t('case.repoPrivate'))
  : undefined;
---
<BaseLayout lang={lang} title={localize(entry.data.title, lang) ?? entry.id} description={localize(entry.data.summary, lang)}>
  <Breadcrumbs items={[
    { label: t('nav.cases'), href: `/${lang}/case-studies` },
    { label: localize(entry.data.title, lang) ?? entry.id },
  ]} />
  <LevelNav lang={lang} caseId={caseId} iterations={caseIterations} />
  <h1>{localize(entry.data.title, lang)}</h1>
  <p>
    <span class="tag">v{displayVersion(iterations, entry)}</span>
    <span class="tag">{entry.data.status}</span>
    {entry.data.demoUrl && <a class="button" style="margin-left:.6rem" href={entry.data.demoUrl}>{t('cases.openDemo')}</a>}
  </p>

  <div>
    {entry.data.intro
      ? localize<string[]>(entry.data.intro, lang)!.map((p) => <p>{p}</p>)
      : <Content />}
  </div>

  {/* The development-over-time view: every published iteration stays listed and reachable,
      newest first. Each has its own stable URL — earlier ones never disappear. */}
  {caseIterations.length > 0 && (
    <>
      <h2>{t('iter.h2')}</h2>
      <ul class="reset">
        {[...caseIterations].reverse().map((it) => (
          <li class="card">
            <a class="card-link" href={`/${lang}/case-studies/${caseId}/${it.data.version}`}>
              <strong>{localize(it.data.title, lang)}</strong>
            </a>
            <span class="tag" style="margin-left:.5rem">v{it.data.version}</span>
            {it.id === current?.id && <span class="tag" style="margin-left:.3rem">{t('iter.current')}</span>}
            <span class="muted small" style="margin-left:.5rem">{it.data.date.toISOString().slice(0, 10)}</span>
            <p class="muted small" style="margin:.4rem 0 0">{localize(it.data.summary, lang)}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {stakeholders.length > 0 && (
    <>
      <h2>{t('case.stakeholders')}</h2>
      <ul class="reset">
        {stakeholders.map((s) => (
          <li class="card">
            <strong>{s.data.name}</strong> — {localize(s.data.role, lang)}
            <span class="tag" style="margin-left:.5rem">{t('case.influence')} {s.data.influence}</span>
            {localize<string[]>(s.data.interests, lang)!.length > 0 && (
              <p class="muted small" style="margin:.3rem 0 0">{t('case.interests')} {localize<string[]>(s.data.interests, lang)!.join(', ')}</p>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  {diagrams.map((d) => (
    <>
      <h2>{localize(d.data.title, lang)}</h2>
      <p class="muted small">{d.data.type.toUpperCase()} · {t('case.madeWith')} {d.data.tool}</p>
      {d.data.image
        ? <img src={d.data.image} alt={localize(d.data.caption, lang) ?? localize(d.data.title, lang)} style="max-width:100%" />
        : <Mermaid code={d.body ?? ''} />}
      {d.data.caption && <p class="muted small">{localize(d.data.caption, lang)}</p>}
      {d.data.aiContribution && <p class="ai-note"><strong>{t('case.aiContribution')}</strong> {localize(d.data.aiContribution, lang)}</p>}
    </>
  ))}

  {storyRows.length > 0 && (
    <>
      <h2>{t('case.storiesTrace')}</h2>
      {repoNote && <p class="small">{repoNote}</p>}
      {storyRows.map(({ story, requirement, adrs, bpmn, codeHref, sourceHref }) => (
        <div class="card">
          <strong>{story.id}: {localize(story.data.title, lang)}</strong>
          <span class="tag" style="margin-left:.5rem">{story.data.status}</span>
          {story.data.jiraKey && <span class="tag" style="margin-left:.3rem">Jira {story.data.jiraKey}</span>}
          <p class="small" style="margin:.5rem 0">
            {t('case.asA')} <em>{localize(story.data.asA, lang)}</em> {t('case.iWant')} <em>{localize(story.data.iWant, lang)}</em>, {t('case.soThat')} <em>{localize(story.data.soThat, lang)}</em>.
          </p>
          <p class="small flow">
            <span class="step">{t('case.requirement')} {requirement ? <a href={`/${lang}/traceability`}>{requirement.id} — {localize(requirement.data.title, lang)}</a> : story.data.requirement.id}</span>
            {bpmn && <span class="step">{t('case.process')} {localize(bpmn.data.title, lang)}</span>}
            {adrs.length > 0 && <span class="step">{t('case.decisions')} {adrs.map((a) => a && localize(a.data.title, lang)).filter(Boolean).join('; ')}</span>}
            {story.data.codeUrl && (
              <span class="step">{t('case.code')} {codeHref
                ? <a href={codeHref}>{t('case.github')}</a>
                : <code>{story.data.codeUrl}</code>}</span>
            )}
            {sourceHref && <span class="step"><a href={sourceHref}>{t('case.source')}</a></span>}
          </p>
          <details>
            <summary class="small">{t('case.acceptance')} ({localize<string[]>(story.data.acceptanceCriteria, lang)!.length})</summary>
            <ul>{localize<string[]>(story.data.acceptanceCriteria, lang)!.map((c) => <li class="small">{c}</li>)}</ul>
          </details>
          <p class="ai-note"><strong>{t('case.aiContribution')}</strong> {localize(story.data.aiContribution, lang)}</p>
        </div>
      ))}
    </>
  )}

  {adrs.length > 0 && (
    <>
      <h2>{t('case.adr')}</h2>
      <ul class="reset">
        {adrs.map((a) => (
          <li class="card">
            <strong>{a.id}: {localize(a.data.title, lang)}</strong>
            <span class="tag" style="margin-left:.5rem">{a.data.status}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
