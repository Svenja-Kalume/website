---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, useTranslations, localize, toLang } from '../../../i18n/ui';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LevelNav from '../../../components/LevelNav.astro';
import DiagramFigure from '../../../components/DiagramFigure.astro';
import StoryCard from '../../../components/StoryCard.astro';
import AdrCard from '../../../components/AdrCard.astro';
import CaseFigures from '../../../components/CaseFigures.astro';
import { allIterations, iterationsOf, currentOf, displayVersion, iterationSlug, iterationLabel } from '../../../lib/iterations';
import { absoluteUrl, techArticleSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const cases = await getCollection('case-studies');
  // One page per (locale × case study). References stay language-neutral.
  return Object.keys(languages).flatMap((lang) =>
    cases.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { entry } = Astro.props;
const caseId = entry.id;
const { Content } = await render(entry);

const inCase = (e: { data: { case?: { id: string } } }) => e.data.case?.id === caseId;

const stories = (await getCollection('user-stories')).filter(inCase);
const adrs = (await getCollection('adr')).filter(inCase);
const diagrams = (await getCollection('diagrams')).filter(inCase);

const iterations = await allIterations();
const caseIterations = iterationsOf(iterations, caseId);
// Worked examples, resolved to the level that tells each one. One today; a list regardless.
const chains = (await Promise.all(
  [entry.data.workedExample].filter((r): r is NonNullable<typeof r> => !!r).map((r) => getEntry(r))
))
  .map((fix) => ({ fix, it: fix?.data.introducedIn && caseIterations.find((i) => i.id === fix.data.introducedIn!.id) }))
  .filter((x): x is { fix: NonNullable<typeof x.fix>; it: NonNullable<typeof x.it> } => !!x.fix && !!x.it);
const current = currentOf(iterations, caseId);

// While there is exactly one case study this page IS the top of the trail -- the
// navigation names it, and the index it would point back at is not built. A trail of
// one unlinked crumb is chrome about nothing. A second case study restores both.
const onlyCase = (await getCollection('case-studies')).length === 1;

// Diagrams, stories and ADRs are shown on the level that introduced them, not here: this
// page is the overview. The levels themselves open from the first key figure, which
// replaced the separate iteration list that repeated them further down.

// Fallback, not a second home: an artifact with no `introducedIn` has no level to move to,
// so it stays visible here rather than disappearing from the site. Everything that does
// carry one is rendered by that level — including what no topic claims, which has its own
// heading there. This page stays the overview: the trail, the people, the levels.
const looseDiagrams = diagrams.filter((d) => !d.data.introducedIn);
const looseStories = stories.filter((s) => !s.data.introducedIn);
const looseAdrs = adrs.filter((a) => !a.data.introducedIn);
---
<BaseLayout
  lang={lang}
  title={localize(entry.data.title, lang) ?? entry.id}
  description={localize(entry.data.summary, lang)}
  jsonLd={techArticleSchema({
    headline: localize(entry.data.title, lang) ?? entry.id,
    description: localize(entry.data.summary, lang),
    url: absoluteUrl(`/${lang}/case-studies/${entry.id}/`, Astro.site),
    lang,
    datePublished: current?.data.date,
    version: displayVersion(iterations, entry),
  })}
>
  {!onlyCase && (
    <Breadcrumbs items={[
      { label: t('nav.cases'), href: `/${lang}/case-studies` },
      { label: localize(entry.data.title, lang) ?? entry.id },
    ]} />
  )}
  <LevelNav lang={lang} caseId={caseId} iterations={caseIterations} />
  <h1>{localize(entry.data.title, lang)}</h1>
  <p>
    <span class="tag">v{displayVersion(iterations, entry)}</span>
    <span class="tag">{entry.data.status}</span>
    {entry.data.demoUrl && <a class="button" style="margin-left:.6rem" href={entry.data.demoUrl}>{t('cases.openDemo')}</a>}
  </p>
  {localize(entry.data.lede, lang) && <p class="lede">{localize(entry.data.lede, lang)}</p>}

  {/* The opener: what the work amounts to, counted, before any of its vocabulary. */}
  <CaseFigures lang={lang} caseId={caseId} iterations={caseIterations} workedExample={entry.data.workedExample?.id} />

  <div>
    {entry.data.intro
      ? localize<string[]>(entry.data.intro, lang)!.map((p) => <p>{p}</p>)
      : <Content />}
  </div>

  {/* Findings followed through the whole chain. Each is told on the level whose fix ends
      it; the overview only lists them, so a second one adds a line here, not a section. */}
  {chains.length > 0 && (
    <>
      <h2 id="chains">{t('chain.list.h2')}</h2>
      <ul>
        {chains.map(({ fix, it }) => (
          <li>
            <a href={`/${lang}/case-studies/${caseId}/${iterationSlug(it, caseIterations)}#chain-${fix.id}`}>{localize(fix.data.title, lang)}</a>
            <span class="muted"> · {iterationLabel(it, t('iter.level'))}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  {looseDiagrams.length > 0 && (
    <>
      <h2>{t('iter.diagrams')}</h2>
      {looseDiagrams.map((d) => <DiagramFigure diagram={d} lang={lang} />)}
    </>
  )}

  {looseStories.length > 0 && (
    <>
      <h2>{t('case.storiesTrace')}</h2>
      {looseStories.map((story) => (
        <StoryCard story={story} lang={lang} repoUrl={entry.data.repoUrl} />
      ))}
    </>
  )}

  {looseAdrs.length > 0 && (
    <>
      <h2>{t('case.adr')}</h2>
      {looseAdrs.map((a) => <AdrCard adr={a} lang={lang} />)}
    </>
  )}
</BaseLayout>
