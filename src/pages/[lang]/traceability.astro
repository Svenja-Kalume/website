---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, localize, toLang } from '../../i18n/ui';
import { iterationLabel, iterationSlug, byOrder, iterationsOf } from '../../lib/iterations';
import EvidenceChain from '../../components/EvidenceChain.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

// Requirements explorer: computes the chain requirement → story → ADR/code from the references.
// Grouped PER CASE STUDY — one flat table across every project becomes unreadable as soon
// as there is more than one, and the projects have nothing to compare anyway.
const requirements = (await getCollection('requirements')).sort((a, b) => a.id.localeCompare(b.id));
const stories = await getCollection('user-stories');
const adrs = await getCollection('adr');
const diagrams = await getCollection('diagrams');

// The level a story shipped in, resolved once. It hangs off the story, not the requirement:
// a requirement is worked across iterations, so a single level per row would be a lie as
// soon as the second one touches it. Seeing which levels a requirement spans is the point.
const allIterationList = await getCollection('iterations');
const iterations = new Map(allIterationList.map((it) => [it.id, it]));

const rows = await Promise.all(
  requirements.map(async (req) => {
    const linked = stories.filter((s) => s.data.requirement.id === req.id);
    const caseEntry = await getEntry(req.data.case);
    // The rest of the chain, from the references the stories and decisions carry: a
    // decision belongs to the requirement when one of its stories cites it or it names the
    // requirement itself; a diagram when one of its stories cites it as its process.
    const adrIds = new Set([
      ...linked.flatMap((s) => s.data.adr.map((r) => r.id)),
      ...adrs.filter((a) => a.data.relatedRequirements.some((r) => r.id === req.id)).map((a) => a.id),
    ]);
    const diagramIds = new Set(linked.map((s) => s.data.bpmn?.id).filter(Boolean));
    return {
      req, caseEntry, stories: linked,
      adrs: adrs.filter((a) => adrIds.has(a.id)).sort((a, b) => a.id.localeCompare(b.id)),
      diagrams: diagrams.filter((d) => diagramIds.has(d.id)),
    };
  })
);

const byCase = new Map<string, typeof rows>();
for (const row of rows) {
  const key = row.req.data.case.id;
  if (!byCase.has(key)) byCase.set(key, []);
  byCase.get(key)!.push(row);
}
const groups = [...byCase.entries()]
  .map(([caseId, items]) => ({
    caseId,
    title: items[0].caseEntry ? localize(items[0].caseEntry.data.title, lang) : caseId,
    // The case study's worked example: one defect followed through every artifact it
    // touched — what this table makes possible, shown on a real case.
    workedExample: items[0].caseEntry?.data.workedExample?.id,
    caseIterations: iterationsOf(allIterationList, caseId),
    items,
    // The levels this case actually has stories in — derived, so the filter can never
    // offer a level that would empty the table, and a third iteration adds its button
    // by being published rather than by editing this page.
    levels: [
      ...new Map(
        items
          .flatMap((r) => r.stories)
          .map((st) => (st.data.introducedIn ? iterations.get(st.data.introducedIn.id) : undefined))
          .filter((it): it is NonNullable<typeof it> => Boolean(it))
          .map((it) => [it.id, it])
      ).values(),
    ].sort(byOrder),
  }))
  .sort((a, b) => a.caseId.localeCompare(b.caseId));
// Where an artifact is rendered in full: the level that introduced it, at its card.
const levelOf = (e: { data: { introducedIn?: { id: string } } }) =>
  e.data.introducedIn ? iterations.get(e.data.introducedIn.id) : undefined;
const hrefOf = (e: { id: string; data: { introducedIn?: { id: string } } }) => {
  const it = levelOf(e);
  return it ? `/${lang}/case-studies/${it.data.case.id}/${iterationSlug(it, allIterationList)}#${e.id}` : undefined;
};
const short = (id: string) => id.replace(/^[A-Z]+-/, '');
// One project: the case heading and the case column are both redundant.
const showCase = groups.length > 1;
---
<BaseLayout lang={lang} title={t('trace.h1')} description={t('trace.desc')}>
  <h1>{t('trace.h1')}</h1>
  <p class="muted">{t('trace.intro')}</p>
  {rows.length === 0 && <p class="muted">{t('trace.empty')}</p>}
  {groups.map((g) => (
    <div class="trace-group" data-trace-group>
      {showCase && <h2>{g.title}</h2>}
      {/* Filtering is presentation, so it happens in the browser and the page ships every
          row: without JS the full table is what you get, which is the honest default for
          a document. Hidden until the script runs, so a dead control is never shown. */}
      {g.levels.length > 1 && (
        <p class="trace-filter" hidden>
          <span class="muted small">{t('trace.filter')}</span>
          <button type="button" class="chip" data-level="" aria-pressed="true">{t('trace.filter.all')}</button>
          {g.levels.map((it) => (
            <button type="button" class="chip" data-level={it.id} aria-pressed="false">
              {iterationLabel(it, t('iter.level'))}
            </button>
          ))}
        </p>
      )}
      <div class="table-scroll">
        <table class="trace-table">
          {/* Widths declared next to the conditional case column, so the two can never
              disagree. The stories cell carries several lines, a level tag and a MoSCoW
              tag; the requirement cell an id and one title — the space belongs to the
              stories. */}
          <colgroup>
            <col style={showCase ? 'width:20%' : 'width:24%'} />
            {showCase && <col style="width:12%" />}
            <col style={showCase ? 'width:46%' : 'width:54%'} />
            <col style={showCase ? 'width:22%' : 'width:22%'} />
          </colgroup>
          <thead>
            <tr>
              <th>{t('trace.th.req')}</th>
              {showCase && <th>{t('trace.th.case')}</th>}
              <th>{t('trace.th.stories')}</th>
              <th>{t('trace.th.model')}</th>
            </tr>
          </thead>
          <tbody>
            {g.items.map(({ req, caseEntry, stories, adrs, diagrams }) => {
              // Stories grouped by the level that shipped them: the level is said once per
              // group instead of once per story, which halved the row heights.
              const byLevel = [...new Map(stories.map((s) => [levelOf(s)?.id ?? '', levelOf(s)])).entries()]
                .sort((x, y) => (x[1]?.data.order ?? 0) - (y[1]?.data.order ?? 0))
                .map(([id, it]) => ({ id, it, stories: stories.filter((s) => (levelOf(s)?.id ?? '') === id) }));
              return (
              <tr id={req.id} data-levels={byLevel.map((x) => x.id).filter(Boolean).join(' ')}>
                <td>
                  <strong>{req.id}</strong><br /><span class="small">{localize(req.data.title, lang)}</span>
                  {stories.length > 0 && (
                    <span class="muted small cover">{stories.length} {t('iter.stories')} · {byLevel.map((x) => x.it ? iterationLabel(x.it, t('iter.level')) : '').filter(Boolean).join(', ')}</span>
                  )}
                </td>
                {showCase && <td class="small">{caseEntry ? localize(caseEntry.data.title, lang) : req.data.case.id}</td>}
                <td class="small">
                  {stories.length === 0
                    ? <span class="tag">{t('trace.noStory')}</span>
                    : byLevel.map((grp) => (
                        <div class="lvgroup" data-level={grp.id}>
                          {grp.it && (
                            <a class="lvname" href={`/${lang}/case-studies/${grp.it.data.case.id}/${iterationSlug(grp.it, allIterationList)}`}>
                              {iterationLabel(grp.it, t('iter.level'))}
                            </a>
                          )}
                          {grp.stories.map((s) => (
                            <div class="line">
                              <a href={hrefOf(s)}><code>{short(s.id)}</code></a> {localize(s.data.title, lang)}
                              {/* MoSCoW belongs to the story. Must is the normal case, so only
                                  the exceptions are marked; a story with no tier gets none. */}
                              {s.data.priority && s.data.priority !== 'must' && (
                                <span class="tag" style="margin-left:.4rem">{t(`trace.priority.${s.data.priority}` as const)}</span>
                              )}
                            </div>
                          ))}
                        </div>
                      ))}
                </td>
                {/* Decisions and diagrams share a column: few requirements reach a diagram
                    through a story, and a column of its own was mostly empty. A decision is
                    shown by id (its title on hover) — the title lives on its card. */}
                <td class="small model">
                  {adrs.length > 0 && (
                    <div class="adrs">
                      {adrs.map((x) => (
                        <a href={hrefOf(x)} title={localize(x.data.title, lang)} data-level={levelOf(x)?.id ?? ''}><code>{short(x.id)}</code></a>
                      ))}
                    </div>
                  )}
                  {diagrams.map((d) => (
                    <div class="line dia" data-level={levelOf(d)?.id ?? ''}>
                      <a href={hrefOf(d)}>{localize(d.data.title, lang)}</a>
                    </div>
                  ))}
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="muted small trace-empty" hidden>{t('trace.filterEmpty')}</p>
      {g.workedExample && (
        <EvidenceChain lang={lang} caseId={g.caseId} iterations={g.caseIterations} storyId={g.workedExample} />
      )}
    </div>
  ))}
</BaseLayout>

<script>
  // Show a requirement while any of its stories belongs to the chosen level, and hide the
  // story lines that do not. A requirement with no story at all has no level to match, so
  // it only appears under "all" — the gap it represents belongs to the unfiltered view.
  for (const group of document.querySelectorAll<HTMLElement>('[data-trace-group]')) {
    const bar = group.querySelector<HTMLElement>('.trace-filter');
    if (!bar) continue;
    const empty = group.querySelector<HTMLElement>('.trace-empty');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button[data-level]')];

    const apply = (level: string) => {
      let shown = 0;
      for (const row of group.querySelectorAll<HTMLElement>('tbody tr')) {
        const levels = (row.dataset.levels ?? '').split(' ').filter(Boolean);
        const match = !level || levels.includes(level);
        row.hidden = !match;
        if (match) shown++;
        for (const line of row.querySelectorAll<HTMLElement>('[data-level]')) {
          line.hidden = Boolean(level) && line.dataset.level !== level;
        }
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.level === level));
      if (empty) empty.hidden = shown > 0;
    };

    bar.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.level ?? ''));
  }
</script>
