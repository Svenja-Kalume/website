---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mermaid from '../../components/Mermaid.astro';
import { languages, useTranslations, localize, toLang } from '../../i18n/ui';
import { allIterations, displayVersion } from '../../lib/iterations';
import { absoluteUrl, webSiteSchema } from '../../lib/schema';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
// Derived from the current iteration, not read from case-studies.version — otherwise
// this shows a stale version the day a new iteration publishes.
const iterations = await allIterations();

// The diagram's labels are prose, so the source is a translated string (see i18n/ui.ts).
const redThread = t('home.redThread.code');
---
<BaseLayout
  lang={lang}
  description={t('home.desc')}
  jsonLd={webSiteSchema({
    name: t('site.title'),
    description: t('home.desc'),
    url: absoluteUrl(`/${lang}/`, Astro.site),
    lang,
  })}
>
  <h1>{t('home.h1')}</h1>
  <p>{t('home.p1')}</p>
  <p class="muted">{t('home.p2')}</p>

  <h2>{t('home.redThread')}</h2>
  <Mermaid code={redThread} />

  <h2>{t('nav.cases')}</h2>
  <ul class="reset">
    {cases.map((c) => (
      <li class="card">
        <a class="card-link" href={`/${lang}/case-studies/${c.id}`}><strong>{localize(c.data.title, lang)}</strong></a>
        <span class="tag" style="margin-left:.5rem">v{displayVersion(iterations, c)}</span>
        <span class="tag" style="margin-left:.3rem">{c.data.status}</span>
        <p class="muted small" style="margin:.4rem 0 0">{localize(c.data.summary, lang)}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
