---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, toLang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('footer.datenschutz')} description={t('datenschutz.desc')}>
  <h1>{t('footer.datenschutz')}</h1>
  {lang === 'de' ? (
    <>
      <p>
        Diese Website verarbeitet keine personenbezogenen Daten. Es gibt keine
        Benutzerkonten, keine Formulare, keine Cookies, kein Tracking und keine
        Analyse-Tools. Es werden keine personenbezogenen Daten erhoben, gespeichert oder
        weitergegeben.
      </p>

      <h2>Verantwortlicher</h2>
      <p>
        Svenja Kalume<br />
        Enzweilerstr. 15, 55743 Idar-Oberstein<br />
        E-Mail: <a href="mailto:svenja.kalume@hotmail.com">svenja.kalume@hotmail.com</a>
      </p>

      <h2>Hosting</h2>
      <p>
        Die Seite ist eine statische Website und wird bei IONOS SE gehostet. Etwaige technische Zugriffsdaten fallen ausschließlich beim
        Hosting-Anbieter an; sie werden vom Betreiber dieser Website weder ausgewertet
        noch genutzt.
      </p>

      <p class="muted small">
        [Hinweis: Diesen Entwurf vor Veröffentlichung rechtlich prüfen und die
        Platzhalter ausfüllen.]
      </p>
    </>
  ) : (
    <>
      <p>
        This website does not process any personal data. There are no user accounts, no
        forms, no cookies, no tracking and no analytics tools. No personal data is
        collected, stored or shared.
      </p>

      <h2>Controller</h2>
      <p>
        Svenja Kalume<br />
        Enzweilerstr. 15, 55743 Idar-Oberstein<br />
        E-mail: <a href="mailto:svenja.kalume@hotmail.com">svenja.kalume@hotmail.com</a>
      </p>

      <h2>Hosting</h2>
      <p>
        This is a static website hosted by IONOS SE. Any
        technical access data arises solely at the hosting provider; it is neither
        evaluated nor used by the operator of this website.
      </p>

      <p class="muted small">
        [Note: have this draft reviewed legally before publishing and fill in the
        placeholders.]
      </p>
    </>
  )}
</BaseLayout>
