---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, useTranslations, localize, toLang } from '../../../i18n/ui';
import { allIterations, iterationLabel } from '../../../lib/iterations';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const entries = (await getCollection('journal'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group by year so the log reads as a timeline, newest first.
const byYear = new Map<number, typeof entries>();
for (const e of entries) {
  const y = e.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(e);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const locale = lang === 'de' ? 'de-DE' : 'en-US';
const fmt = (d: Date) =>
  d.toLocaleDateString(locale, { day: '2-digit', month: 'short' });

// Resolve the (optional) case study each entry links back to.
const caseTitle = async (ref: any) =>
  ref ? localize((await getEntry(ref))?.data.title, lang) : undefined;
const cases = new Map<string, string | undefined>();
for (const e of entries) {
  if (e.data.case) cases.set(e.id, await caseTitle(e.data.case));
}

// The implementation level each entry belongs to. Loaded once for the whole list rather
// than resolved per entry, and rendered as a link into that level's page.
const iterationById = new Map((await allIterations()).map((i) => [i.id, i]));
const levelOf = (e: (typeof entries)[number]) => {
  const it = e.data.iteration ? iterationById.get(e.data.iteration.id) : undefined;
  return it && {
    label: iterationLabel(it, t('iter.level')),
    href: `/${lang}/case-studies/${it.data.case.id}/${it.data.version}`,
    title: localize(it.data.title, lang),
  };
};
---
<BaseLayout lang={lang} title={t('journal.h1')} description={t('journal.desc')}>
  <h1>{t('journal.h1')}</h1>
  <p class="muted">{t('journal.intro')}</p>

  {entries.length === 0 && <p class="muted">{t('journal.empty')}</p>}

  {years.map((year) => (
    <section class="log-year">
      <h2>{year}</h2>
      <ol class="reset log">
        {byYear.get(year)!.map((e) => (
          <li class="log-entry">
            <span class="log-date small muted">{fmt(e.data.date)}</span>
            <div class="log-body">
              <a class="card-link" href={`/${lang}/journal/${e.id}`}><strong>{localize(e.data.title, lang)}</strong></a>
              {e.data.summary && <p class="small muted">{localize(e.data.summary, lang)}</p>}
              <p class="small log-meta">
                {e.data.case && cases.get(e.id) && (
                  <span class="tag">{cases.get(e.id)}</span>
                )}
                {levelOf(e) && (
                  <a class="tag" href={levelOf(e)!.href} title={levelOf(e)!.title}>{levelOf(e)!.label}</a>
                )}
                {e.data.tags.map((t) => <span class="tag">{t}</span>)}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</BaseLayout>
