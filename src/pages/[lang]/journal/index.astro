---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JournalList from '../../../components/JournalList.astro';
import JournalTagFilter from '../../../components/JournalTagFilter.astro';
import { languages, useTranslations, toLang } from '../../../i18n/ui';
import { journalEntries } from '../../../lib/journal';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const entries = await journalEntries();
---
<BaseLayout lang={lang} title={t('journal.h1')} description={t('journal.desc')}>
  <h1>{t('journal.h1')}</h1>
  <p class="muted">{t('journal.intro')}</p>

  {entries.length === 0 && <p class="muted">{t('journal.empty')}</p>}

  <JournalTagFilter entries={entries} lang={lang} />
  <JournalList entries={entries} lang={lang} />
</BaseLayout>
