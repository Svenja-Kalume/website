---
/**
 * The log filtered to a tag combination, at its own URL: /en/journal/tags/ddd+testing
 *
 * Static pages rather than a scripted filter — the filtered view is then citable, works
 * without JavaScript, and the tag chips on an entry are already links to it. Only the
 * combinations some entry actually carries are generated, so no URL here is ever empty.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import JournalList from '../../../../components/JournalList.astro';
import JournalTagFilter from '../../../../components/JournalTagFilter.astro';
import { languages, useTranslations, toLang } from '../../../../i18n/ui';
import { journalEntries, tagCombos, filterByTags } from '../../../../lib/journal';

export async function getStaticPaths() {
  const entries = await journalEntries();
  return Object.keys(languages).flatMap((lang) =>
    tagCombos(entries).map((tags) => ({ params: { lang, tag: tags.join('+') }, props: { tags } }))
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { tags } = Astro.props;

const all = await journalEntries();
const entries = filterByTags(all, tags);
const heading = `${t('journal.taggedWith')} ${tags.join(' + ')}`;
---
<BaseLayout lang={lang} title={heading} description={t('journal.desc')}>
  <Breadcrumbs items={[
    { label: t('journal.h1'), href: `/${lang}/journal` },
    { label: tags.join(' + ') },
  ]} />
  <h1>{heading}</h1>
  <p class="muted">{entries.length} {entries.length === 1 ? t('journal.entry') : t('journal.entries')}</p>

  <JournalTagFilter entries={all} lang={lang} activeTags={tags} />
  <JournalList entries={entries} lang={lang} activeTags={tags} />
</BaseLayout>
