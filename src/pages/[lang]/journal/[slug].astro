---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { absoluteUrl, blogPostingSchema } from '../../../lib/schema';
import { languages, useTranslations, localize, toLang } from '../../../i18n/ui';
import { iterationLabel } from '../../../lib/iterations';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return Object.keys(languages).flatMap((lang) =>
    entries.map((entry) => ({ params: { lang, slug: entry.id }, props: { entry } }))
  );
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedCase = entry.data.case ? await getEntry(entry.data.case) : undefined;
// The implementation level the entry belongs to, linked to that level's own page —
// so a reader can go from "what happened that day" to "what that level shipped".
const iteration = entry.data.iteration ? await getEntry(entry.data.iteration) : undefined;

const locale = lang === 'de' ? 'de-DE' : 'en-US';
const fmt = (d: Date) =>
  d.toLocaleDateString(locale, { day: '2-digit', month: 'long', year: 'numeric' });
---
<BaseLayout
  lang={lang}
  title={localize(entry.data.title, lang) ?? entry.id}
  description={localize(entry.data.summary, lang)}
  jsonLd={blogPostingSchema({
    headline: localize(entry.data.title, lang) ?? entry.id,
    description: localize(entry.data.summary, lang),
    datePublished: entry.data.date,
    url: absoluteUrl(`/${lang}/journal/${entry.id}/`, Astro.site),
    lang,
    keywords: entry.data.tags,
  })}
>
  <p class="small"><a href={`/${lang}/journal`}>{t('journal.back')}</a></p>
  <p class="log-date-full small muted">
    <time datetime={entry.data.date.toISOString().slice(0, 10)}>{fmt(entry.data.date)}</time>
  </p>
  <h1>{localize(entry.data.title, lang)}</h1>
  <p class="log-meta small">
    {relatedCase && (
      <a class="tag" href={`/${lang}/case-studies/${relatedCase.id}`}>{localize(relatedCase.data.title, lang)}</a>
    )}
    {iteration && (
      <a
        class="tag"
        href={`/${lang}/case-studies/${iteration.data.case.id}/${iteration.data.version}`}
        title={localize(iteration.data.title, lang)}
      >{iterationLabel(iteration, t('iter.level'))}</a>
    )}
    {entry.data.tags.map((tag) => <span class="tag">{tag}</span>)}
  </p>
  {entry.data.body
    ? localize<string[]>(entry.data.body, lang)!.map((p) => <p>{p}</p>)
    : <Content />}
</BaseLayout>
