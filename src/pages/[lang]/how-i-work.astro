---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Mermaid from '../../components/Mermaid.astro';
import { languages, useTranslations, localize, toLang } from '../../i18n/ui';
import { allIterations, groupByCase } from '../../lib/iterations';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

// Workflow steps are grouped BY PROJECT, resolved through introducedIn -> iteration ->
// case. Sorting them globally by `order` would interleave two projects' processes into
// one nonsensical list — `order` is a position within one project's step list, not a
// site-wide rank.
const iterations = await allIterations();
const cases = await getCollection('case-studies');
const caseTitle = new Map(cases.map((c) => [c.id, localize(c.data.title, lang)]));

const grouped = groupByCase(iterations, await getCollection('workflow'));
const groups = [...grouped.entries()]
  .map(([caseId, steps]) => ({
    caseId,
    title: caseId ? caseTitle.get(caseId) ?? caseId : null,
    steps: steps.sort((a, b) => a.data.order - b.data.order),
  }))
  .sort((a, b) => String(a.caseId ?? '￿').localeCompare(String(b.caseId ?? '￿')));
const stepCount = groups.reduce((n, g) => n + g.steps.length, 0);
// One project: keep the plain list, no redundant heading above it.
const showGroupHeadings = groups.length > 1;

const mcpFlow = `flowchart TD
  N[Workshop notes] --> L1[LLM drafts glossary]
  L1 --> RV{Human review}
  RV -- ok --> L2[LLM proposes user stories]
  RV -- needs refinement --> L1
  L2 --> RV2{Human review}
  RV2 -- ok --> JI[User stories]
  RV2 -- needs refinement --> L2
  JI --> L3[LLM checks consistency between glossary and stories]
  L3 --> RV3{Human review}
  RV3 -- ok --> DEV["Development (incl. automated tests)"]
  RV3 -- needs refinement --> L3
  RV3 -- glossary or stories wrong --> L1
  DEV --> RV4{AI review}
  RV4 -- ok --> MT{Manual tests}
  RV4 -- needs refinement --> DEV
  MT -- ok --> ST{Stakeholder tests}
  MT -- needs refinement --> DEV
  ST -- ok --> DONE[Increment done]
  ST -- needs refinement --> N`;
---
<BaseLayout lang={lang} title={t('how.h1')} description={t('how.desc')}>
  <h1>{t('how.h1')}</h1>
  <p>{t('how.intro')}</p>

  <h2>{t('how.mcp')}</h2>
  <Mermaid code={mcpFlow} />

  <h2>{t('how.steps')}</h2>
  {stepCount === 0 && <p class="muted">{t('how.empty')}</p>}
  {groups.map((g) => (
    <>
      {showGroupHeadings && <h3>{g.title ?? t('how.ungrouped')}</h3>}
      <ol>
        {g.steps.map((s) => (
          <li class="card" style="list-style:none">
            <strong>{localize(s.data.title, lang)}</strong>
            {s.data.tools.length > 0 && <p class="small muted" style="margin:.3rem 0">{t('how.tools')} {s.data.tools.join(', ')}</p>}
            <p class="ai-note"><strong>{t('case.aiContribution')}</strong> {localize(s.data.aiRole, lang)}</p>
          </li>
        ))}
      </ol>
    </>
  ))}
</BaseLayout>
