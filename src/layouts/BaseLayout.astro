---
import '../styles/global.css';
import { useTranslations, alternatePath, toLang, type Lang } from '../i18n/ui';

interface Props { title: string; description?: string; lang: Lang; }
const { title, description, lang } = Astro.props;
const t = useTranslations(lang);

const SITE_TITLE = 'Making Complexity Understandable';
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

const nav = [
  { href: '', key: 'nav.home' as const },
  { href: '/case-studies', key: 'nav.cases' as const },
  { href: '/how-i-work', key: 'nav.how' as const },
  { href: '/traceability', key: 'nav.trace' as const },
  { href: '/journal', key: 'nav.journal' as const },
  { href: '/about', key: 'nav.about' as const },
];

const switchLang = toLang(lang === 'en' ? 'de' : 'en');
const switchHref = alternatePath(Astro.url.pathname, lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" hreflang={switchLang} href={switchHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /* Apply a saved theme before paint so there is no flash. No saved value =
         follow the OS (prefers-color-scheme). */
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site">
      <nav>
        <a class="brand" href={`/${lang}/`}>{SITE_TITLE}</a>
        {nav.slice(1).map((i) => <a href={`/${lang}${i.href}`}>{t(i.key)}</a>)}
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={t('theme.toggle.aria')}>
          <span class="icon-light" aria-hidden="true">☾</span>
          <span class="icon-dark" aria-hidden="true">☀</span>
        </button>
        <a class="lang-switch" href={switchHref} lang={switchLang} aria-label={t('lang.switch.aria')}>
          {t('lang.switch')}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      {t('footer')}
    </footer>
    <script is:inline>
      /* Flip between light and dark, remembering the choice. Reads the current
         effective theme (explicit override, else OS) and stores the opposite. */
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', function () {
        var root = document.documentElement;
        var current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
