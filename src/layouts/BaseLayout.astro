---
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { useTranslations, alternatePath, toLang, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  /** Optional schema.org graph for this page, emitted as JSON-LD. */
  jsonLd?: unknown;
}
const { title, description, lang, jsonLd } = Astro.props;
const t = useTranslations(lang);

const SITE_TITLE = t('site.title');
const pageTitle = !title || title === SITE_TITLE ? SITE_TITLE : `${title} — ${SITE_TITLE}`;

const SITE_OWNER = 'Svenja Kalume';
const year = new Date().getFullYear();

// While there is exactly one case study, the nav links straight at it and
// names it; the index page stays reachable but is not worth a click of its own.
// Add a second case study and this falls back to the list without a code change.
const caseStudies = await getCollection('case-studies');
const onlyCase = caseStudies.length === 1 ? caseStudies[0] : undefined;

const nav = [
  { href: '', key: 'nav.home' as const },
  onlyCase
    ? { href: `/case-studies/${onlyCase.id}`, key: 'nav.cases.only' as const }
    : { href: '/case-studies', key: 'nav.cases' as const },
  { href: '/how-i-work', key: 'nav.how' as const },
  { href: '/traceability', key: 'nav.trace' as const },
  { href: '/journal', key: 'nav.journal' as const },
  { href: '/about', key: 'nav.about' as const },
];

const switchLang = toLang(lang === 'en' ? 'de' : 'en');
const switchHref = alternatePath(Astro.url.pathname, lang);

// Canonical and hreflang have to be absolute URLs -- a relative hreflang is ignored
// outright, and the pair only counts as a cluster if every page names *itself* too.
// `site` in astro.config.mjs is the single place the domain is written.
const abs = (path: string) => new URL(path, Astro.site ?? 'https://svenjakalume.de').href;
const canonical = abs(Astro.url.pathname);
const switchCanonical = abs(switchHref);
// x-default names the locale a visitor lands on without a language signal, which is
// the same one the bare domain redirects to: English.
const defaultCanonical = lang === defaultLang ? canonical : switchCanonical;

// One preview image per locale, generated by scripts/make-og-image.mjs. Scrapers fetch
// it server-side (no CORS involved), but they do reject SVG -- hence a raster file --
// and they cache it hard, so the filename changes when the image does.
const ogImage = abs(`/og/${lang}.png`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={switchLang} href={switchCanonical} />
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.imageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t('og.imageAlt')} />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('journal.h1')} — ${SITE_TITLE}`}
      href={`/${lang}/journal/rss.xml`}
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site">
      <div class="masthead">
        <a class="brand" href={`/${lang}/`}>
          <span class="brand-title">{SITE_TITLE}</span>
          <span class="tagline">{t('site.subtitle')}</span>
        </a>
        <nav>
          {nav.slice(1).map((i) => <a href={`/${lang}${i.href}`}>{t(i.key)}</a>)}
          <a class="lang-switch" href={switchHref} lang={switchLang} aria-label={t('lang.switch.aria')}>
            {t('lang.switch')}
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div>
        <p class="footer-tagline">{t('footer')}</p>
        <nav class="footer-links">
          <a href={`/${lang}/impressum`}>{t('footer.impressum')}</a>
          <span aria-hidden="true">·</span>
          <a href={`/${lang}/datenschutz`}>{t('footer.datenschutz')}</a>
        </nav>
        <p class="footer-copy">© {year} {SITE_OWNER} · {t('footer.rights')}</p>
      </div>
    </footer>
  </body>
</html>
